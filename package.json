{
  "name": "videomanch-backend",
  "version": "1.0.0",
  "description": "Video transcoding backend with BullMQ and R2",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/app/start.ts",
    "dev:worker": "tsx watch src/workers/analytics.worker.ts",
    "dev:all": "npx -y concurrently \"npm run dev\" \"npm run dev:worker\"",
    "build": "tsc",
    "start": "node dist/app/start.js",
    "start:worker": "node dist/workers/analytics.worker.js",
    "worker": "tsx src/workers/transcodeWorker.ts",
    "seed:admin": "tsx scripts/seedAdmin.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.500.0",
    "@aws-sdk/s3-request-presigner": "^3.500.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.1.0",
    "rate-limit-redis": "^4.2.0",
    "socket.io": "^4.8.3",
    "uuid": "^9.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.11.0",
    "@types/uuid": "^9.0.7",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
